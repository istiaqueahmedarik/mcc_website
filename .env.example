# Supabase
SUPABASE_URL=https://exmaple.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://exmaple.supabase.co
SUPABASE_ANON_KEY=Supbase_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=Supbase_anon_key
SUPABASE_SERVICE_KEY=Supbase_service_key
SUPABASE_SERVICE_ROLE_KEY=Supbase_service_role_key
HOST_NAME=exmaple.supabase.co

# AI
GOOGLE_GENERATIVE_AI_API_KEY=Googel_Generative_AI_API_Key
AGENTIC_API_KEY=Agnetic_API_Key

# Server / Client URLs
SERVER_URL=http://mcc-backned:5000
NEXT_PUBLIC_SERVER_URL=http://mcc-backned:5000
CLIENT_URL=http://localhose:3000
NEXT_PUBLIC_CLIENT_URL=http://localhose:3000
APP_BASE_URL=http://localhose:3000
SERVER_PUBLIC_URL=http://localhose:5000
PORT=5000

# Database
DATABASE_URL=postgresql://user:passwrod@host:port/dbname

# Email
EMAIL_PASS=your_emial_passwrod_here
EMAIL_USER=your_emial_user_here

# Auth secret
SECRET=your_secreat_here

# VJudge
VJUDGE_USERNAME=your_vjudge_usernmae_here
VJUDGE_PASSWORD=your_vjudge_passwrod_here

# Cloudflare
CF_CLIENT_ID=your_cf_clinet_id_here
CF_CLIENT_SECRET=your_cf_clinet_secreat_here

# Discord
DISCORD_INTEGRATION_ENABLED=true
DISCORD_LINK_ENFORCEMENT_MODE=off
DISCORD_CLIENT_ID=your_discrod_clinet_id_here
DISCORD_CLIENT_SECRET=your_discrod_clinet_secreat_here
DISCORD_BOT_TOKEN=your_discrod_bot_token_here
DISCORD_REDIRECT_URI=http://localhose:3000/api/auth/callback/discord
DISCORD_DEV_GUILD_ID=your_discrod_dev_guild_id_here
DISCORD_TOKEN_ENCRYPTION_KEY=your_discrod_token_encryption_key_here

# Codeforces
CODEFORCES_CREDENTIAL_ENCRYPTION_KEY=your_codefroces_encryption_key_here

# Feature flags
ENABLE_TEAM_FINALIZATION_EMAILS=false
NEXT_PUBLIC_DEBUG_PROFILE_BATCH=false

# Public website URLs
NEXT_PUBLIC_WEBSITE_URL=https://exmaple.com
NEXT_PUBLIC_FACEBOOK_URL=https://facebok.com/exmaple
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/exmaple
NEXT_PUBLIC_DISCORD_URL=https://discrod.gg/exmaple